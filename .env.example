# =============================================================================
# DataMend Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# --- Supabase Configuration ---
# Get these from: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- JWT Secret ---
# Get from: Supabase Dashboard → Settings → API → JWT Secret
JWT_SECRET=your-supabase-jwt-secret

# --- AI Integration (Optional) ---
# If not set, the rule-based NLP interpreter will be used instead.
OPENAI_API_KEY=sk-your-openai-api-key

# --- Backend Configuration ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- File Processing Limits ---
MAX_FILE_SIZE_MB=50
MAX_ROWS=500000

# --- Admin Initialization ---
# Set to "true" ONLY when initializing the admin account for the first time.
# MUST be set to "false" or removed in production after initialization.
ALLOW_ADMIN_INIT=true

# --- Frontend Environment Variables ---
# These VITE_ prefixed variables are exposed to the frontend build.
# Only include non-secret values here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://localhost:8000

# --- Security Warning ---
# VITE_SUPABASE_ANON_KEY is safe to expose publicly (it has limited permissions).
# SUPABASE_SERVICE_ROLE_KEY must NEVER be used in frontend code.
# In production, restrict VITE_SUPABASE_ANON_KEY with Row Level Security policies.

